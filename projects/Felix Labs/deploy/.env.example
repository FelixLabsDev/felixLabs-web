# Copy to /opt/felixlabs/.env on the server and fill in. Never commit the real file.

# Domain the site is served on. Caddy gets the HTTPS certificate automatically
# once the domain's DNS A record points at this server.
# No domain yet? Use :80 to serve plain HTTP on the server's IP address.
SITE_DOMAIN=felixlabs.example.com

# Where consultation requests are emailed.
MAIL_TO=you@example.com

# SMTP account that sends the email. For Gmail: smtp.gmail.com, port 587,
# your Gmail address, and an App Password (Google Account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sender address; defaults to SMTP_USER. Must be allowed by the SMTP provider.
MAIL_FROM=

# 1 = log requests on the server instead of emailing them (for a first test).
MAIL_DRY_RUN=0
